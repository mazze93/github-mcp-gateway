{
  "name": "github-mcp-gateway",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "remote-mcp-server",
    "cloudflare-workers",
    "durable-objects",
    "github-app",
    "oauth2",
    "oauth21",
    "pkce",
    "claude",
    "claude-code",
    "typescript"
  ],
  "description": "Remote MCP server exposing GitHub (repos, issues, PRs, contents, search) to MCP clients, authenticated via a GitHub App OAuth user-to-server flow. Deployed on Cloudflare Workers.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mazze93/github-mcp-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/mazze93/github-mcp-gateway/issues"
  },
  "homepage": "https://github.com/mazze93/github-mcp-gateway#readme",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tail": "wrangler tail",
    "kv:create": "wrangler kv namespace create OAUTH_KV"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "agents": "^0.20.1",
    "hono": "^4.13.3",
    "octokit": "^5.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260819.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  },
  "overrides": {
    "@hono/node-server": "^2.0.12",
    "undici": "^7.29.0"
  }
}
