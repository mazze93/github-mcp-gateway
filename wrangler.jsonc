{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "github-mcp-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  // global_fetch_strictly_public is NECESSARY BUT NOT SUFFICIENT for CIMD
  // (Client ID Metadata Documents). workers-oauth-provider gates it on BOTH
  // conditions:
  //
  //   client_id_metadata_document_supported:
  //     !!options.clientIdMetadataDocumentEnabled && hasGlobalFetchStrictlyPublic()
  //
  // This flag satisfies the second; src/index.ts supplies the first. Both are
  // required — dropping either one does NOT merely stop advertising CIMD, it
  // makes a URL client_id fall back to a bare KV lookup, so Claude Code
  // resolves only while a stale `client:` record happens to survive in KV and
  // returns "invalid_request: Invalid client_id" once it doesn't.
  //
  // That is not hypothetical: the flag sat here for months without the
  // provider option, and deploy.yml's smoke test flipped 200 -> 400 across two
  // deploys of identical code before it was found. Do not remove either half.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true
  },

  // Comma-separated GitHub logins permitted to use this server (checked at
  // the OAuth callback). Anyone else completing the GitHub consent screen
  // gets a 403 at /callback.
  "vars": {
    "ALLOWED_GITHUB_LOGINS": "mazze93"
  },

  // Workers KV — stores OAuth state (10 min TTL), approved-client cookies' backing
  // data is in the cookie itself, and rotating GitHub refresh tokens (keyed by
  // GitHub login, see src/github-client.ts). One namespace, prefixed keys.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "0773ec3dd785418c984559f47d1623e9"
    }
  ],

  // Durable Object — one instance per authenticated MCP session.
  "durable_objects": {
    "bindings": [
      {
        "class_name": "GitHubMcpAgent",
        "name": "MCP_OBJECT"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GitHubMcpAgent"]
    }
  ]
}
