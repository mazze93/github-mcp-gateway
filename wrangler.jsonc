{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "github-mcp-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  // global_fetch_strictly_public is REQUIRED for CIMD (Client ID Metadata
  // Documents) — workers-oauth-provider gates CIMD support on it, and Claude
  // Code authenticates with a URL client_id
  // (https://claude.ai/oauth/claude-code-client-metadata) rather than a
  // DCR-registered one. Without this flag /authorize throws for every such
  // client and the discovery document reports
  // client_id_metadata_document_supported: false. Do not remove.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true
  },

  // Comma-separated GitHub logins permitted to use this server (checked at
  // the OAuth callback). Anyone else completing the GitHub consent screen
  // gets a 403 at /callback.
  "vars": {
    "ALLOWED_GITHUB_LOGINS": "mazze93"
  },

  // Workers KV — stores OAuth state (10 min TTL), approved-client cookies' backing
  // data is in the cookie itself, and rotating GitHub refresh tokens (keyed by
  // GitHub login, see src/github-client.ts). One namespace, prefixed keys.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "0773ec3dd785418c984559f47d1623e9"
    }
  ],

  // Durable Object — one instance per authenticated MCP session.
  "durable_objects": {
    "bindings": [
      {
        "class_name": "GitHubMcpAgent",
        "name": "MCP_OBJECT"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GitHubMcpAgent"]
    }
  ]
}
